--- /dev/null
+++ windows/vhid_mouse.h
@@ -0,0 +1,27 @@
+#ifndef HARDWARE_SIMULATOR_VHID_MOUSE_H_
+#define HARDWARE_SIMULATOR_VHID_MOUSE_H_
+
+#include <windows.h>
+
+// Optional virtual-HID mouse backend.
+// Dynamically loads WinUHid.dll (https://github.com/cgutman/WinUHid, MIT).
+// Requires the WinUHid UMDF driver to be installed on the host; otherwise
+// all APIs fail and the caller should keep using SendInput.
+//
+// Report ID 1 = relative motion (Raw Input games).
+// Report ID 2 = absolute position (0..65535 over the virtual desktop;
+// multi-monitor / multi-screen control can keep using percent + screenId).
+
+// True when WinUHid.dll exists next to the host exe. Does not LoadLibrary
+// or create a device — safe for settings availability probes.
+bool VhidMouseIsDriverPresent();
+// Load DLL (app-dir LoadLibraryExW) and create the virtual mouse device.
+bool VhidMouseEnsureCreated();
+void VhidMouseDestroy();
+
+bool VhidMouseReportMotion(SHORT dx, SHORT dy);
+bool VhidMouseReportAbsolute(USHORT x, USHORT y);
+bool VhidMouseReportButton(int buttonId, bool down);
+bool VhidMouseReportScroll(SHORT scrollValue, bool horizontal);
+
+#endif  // HARDWARE_SIMULATOR_VHID_MOUSE_H_

+  /// Prefer [MouseInputBackend.vhid] for relative + absolute host injection;
+  /// falls back to SendInput when WinUHid is missing and returns false.
+  static Future<bool> setMouseInputBackend(MouseInputBackend backend) {
+    return HardwareSimulatorPlatform.instance
+        .setMouseInputBackend(backend.index);
+  }
+
+  static Future<MouseInputBackend> getMouseInputBackend() async {
+    final index =
+        await HardwareSimulatorPlatform.instance.getMouseInputBackend();
+    if (index >= 0 && index < MouseInputBackend.values.length) {
+      return MouseInputBackend.values[index];
+    }
+    return MouseInputBackend.sendInput;
+  }
+
+  static Future<MouseInputBackend> getEffectiveMouseInputBackend() async {
+    final index = await HardwareSimulatorPlatform.instance
+        .getEffectiveMouseInputBackend();
+    if (index >= 0 && index < MouseInputBackend.values.length) {
+      return MouseInputBackend.values[index];
+    }
+    return MouseInputBackend.sendInput;
+  }
+
+  static Future<bool> isVhidMouseAvailable() {
+    return HardwareSimulatorPlatform.instance.isVhidMouseAvailable();
+  }

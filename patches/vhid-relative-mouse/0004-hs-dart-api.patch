+/// Host-side mouse injection backend.
+///
+/// Applies to both relative ([HWMouse.performMouseMoveRelative]) and absolute
+/// ([HWMouse.performMouseMoveAbsl]) host injection. Wire framing is unchanged.
+enum MouseInputBackend {
+  /// user32 SendInput (default).
+  sendInput,
+
+  /// Virtual HID mouse via WinUHid when the driver is installed
+  /// (relative report id 1 + absolute report id 2).
+  vhid,
+}

diff --git a/lib/utils/widgets/terminal_link_sheet.dart b/lib/utils/widgets/terminal_link_sheet.dart
new file mode 100644
index 0000000..5c46a02
--- /dev/null
+++ b/lib/utils/widgets/terminal_link_sheet.dart
@@ -0,0 +1,416 @@
+import 'dart:async';
+import 'dart:convert';
+
+import 'package:cloudplayplus/entities/session.dart';
+import 'package:cloudplayplus/services/app_info_service.dart';
+import 'package:cloudplayplus/services/webrtc_service.dart';
+import 'package:cloudplayplus/utils/widgets/message_box.dart';
+import 'package:flutter/material.dart';
+import 'package:session_terminal_link/session_terminal_link.dart';
+
+/// 会话内「终端连接」底栏（主控端）。
+class TerminalLinkSheet {
+  static Future<void> show(BuildContext context) async {
+    final session = WebrtcService.currentRenderingSession;
+    if (session == null ||
+        session.connectionState != StreamingSessionConnectionState.connected) {
+      MessageBoxManager().showMessage(
+        '当前没有已连接的远控会话。',
+        '终端连接',
+      );
+      return;
+    }
+    session.ensureTerminalLink();
+    if (session.terminalLink == null) {
+      MessageBoxManager().showMessage(
+        '终端通道尚未就绪，请等待数据通道建立后再试。',
+        '终端连接',
+      );
+      return;
+    }
+
+    await showModalBottomSheet<void>(
+      context: context,
+      isScrollControlled: true,
+      showDragHandle: true,
+      builder: (ctx) {
+        final height = MediaQuery.sizeOf(ctx).height * 0.85;
+        return SizedBox(
+          height: height,
+          child: SafeArea(
+            child: Padding(
+              padding: const EdgeInsets.fromLTRB(16, 0, 16, 16),
+              child: _TerminalLinkBody(session: session),
+            ),
+          ),
+        );
+      },
+    );
+  }
+}
+
+class _TerminalLinkBody extends StatefulWidget {
+  final StreamingSession session;
+
+  const _TerminalLinkBody({required this.session});
+
+  @override
+  State<_TerminalLinkBody> createState() => _TerminalLinkBodyState();
+}
+
+class _TerminalLinkBodyState extends State<_TerminalLinkBody> {
+  final _output = StringBuffer();
+  final _scrollController = ScrollController();
+  final _inputController = TextEditingController();
+  final _inputFocus = FocusNode();
+
+  StreamSubscription<TerminalOutputEvent>? _outSub;
+  StreamSubscription<List<TermSessionInfo>>? _listSub;
+  StreamSubscription<TermSessionInfo>? _stateSub;
+
+  List<TermSessionInfo> _sessions = const [];
+  String? _activeId;
+  bool _busy = false;
+  String? _status;
+
+  TerminalLinkEngine? get _engine => widget.session.terminalLink;
+
+  TermSessionInfo? get _activeInfo {
+    final id = _activeId;
+    if (id == null) return null;
+    for (final s in _sessions) {
+      if (s.sessionId == id) return s;
+    }
+    return null;
+  }
+
+  static String _stateLabel(TermSessionState s) {
+    switch (s) {
+      case TermSessionState.starting:
+        return '启动中';
+      case TermSessionState.ready:
+        return '就绪';
+      case TermSessionState.attached:
+        return '已附着';
+      case TermSessionState.detached:
+        return '已分离';
+      case TermSessionState.exited:
+        return '已退出';
+      case TermSessionState.failed:
+        return '失败';
+    }
+  }
+
+  @override
+  void initState() {
+    super.initState();
+    final engine = _engine;
+    if (engine == null) return;
+    _sessions = engine.knownSessions;
+    _activeId = engine.activeSessionId;
+    _outSub = engine.output.listen((ev) {
+      if (!mounted) return;
+      if (_activeId != null && ev.sessionId != _activeId) return;
+      setState(() {
+        _output.write(utf8.decode(ev.bytes, allowMalformed: true));
+      });
+      _scrollToEnd();
+    });
+    _listSub = engine.sessionLists.listen((list) {
+      if (!mounted) return;
+      setState(() => _sessions = list);
+    });
+    _stateSub = engine.sessionStates.listen((info) {
+      if (!mounted) return;
+      setState(() {
+        final backend = info.backend != null ? ' · ${info.backend}' : '';
+        _status =
+            '${info.name}: ${_stateLabel(info.state)}$backend${info.error != null ? ' — ${info.error}' : ''}';
+        // Align with engine: only claim focus when unset, matching the
+        // current session, or when the engine already focused this id
+        // (e.g. new open). Never let an unrelated ready/attached steal.
+        if (info.state == TermSessionState.attached ||
+            info.state == TermSessionState.ready) {
+          final engineActive = engine.activeSessionId;
+          if (_activeId == null ||
+              _activeId == info.sessionId ||
+              engineActive == info.sessionId) {
+            _activeId = info.sessionId;
+          }
+        }
+      });
+    });
+    // ignore: discarded_futures
+    engine.list();
+  }
+
+  @override
+  void dispose() {
+    final id = _activeId;
+    final engine = _engine;
+    if (id != null && engine != null) {
+      // 仅分离主控显示；被控进程继续运行（对齐 UU）。
+      // ignore: discarded_futures
+      engine.detach(id);
+    }
+    _outSub?.cancel();
+    _listSub?.cancel();
+    _stateSub?.cancel();
+    _scrollController.dispose();
+    _inputController.dispose();
+    _inputFocus.dispose();
+    super.dispose();
+  }
+
+  void _scrollToEnd() {
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      if (!_scrollController.hasClients) return;
+      _scrollController.jumpTo(_scrollController.position.maxScrollExtent);
+    });
+  }
+
+  Future<void> _newSession() async {
+    final engine = _engine;
+    if (engine == null) return;
+    setState(() => _busy = true);
+    try {
+      _output.clear();
+      await engine.open();
+    } catch (e) {
+      MessageBoxManager().showMessage(e.toString(), '终端连接');
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  Future<void> _attach(TermSessionInfo info) async {
+    final engine = _engine;
+    if (engine == null) return;
+    setState(() {
+      _busy = true;
+      _output.clear();
+      _activeId = info.sessionId;
+    });
+    try {
+      await engine.attach(info.sessionId);
+    } catch (e) {
+      MessageBoxManager().showMessage(e.toString(), '终端连接');
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  Future<void> _kill(TermSessionInfo info) async {
+    final engine = _engine;
+    if (engine == null) return;
+    await engine.kill(info.sessionId);
+    if (_activeId == info.sessionId) {
+      setState(() {
+        _activeId = null;
+        _output.clear();
+      });
+    }
+  }
+
+  Future<void> _splitPane({required bool vertical}) async {
+    final engine = _engine;
+    final id = _activeId;
+    if (engine == null || id == null) return;
+    setState(() => _busy = true);
+    try {
+      await engine.splitPane(id, vertical: vertical);
+    } catch (e) {
+      MessageBoxManager().showMessage(
+        '分屏失败（需被控端已安装 psmux）：$e',
+        '终端连接',
+      );
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  Future<void> _visibleAttach() async {
+    final engine = _engine;
+    final id = _activeId;
+    if (engine == null || id == null) return;
+    setState(() => _busy = true);
+    try {
+      await engine.visibleAttach(id);
+      MessageBoxManager().showMessage(
+        '已请求被控端打开本机 Windows Terminal 附着窗口。',
+        '终端连接',
+      );
+    } catch (e) {
+      MessageBoxManager().showMessage(e.toString(), '终端连接');
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  Future<void> _submitInput([String? raw]) async {
+    final engine = _engine;
+    final id = _activeId;
+    if (engine == null || id == null) return;
+    final text = raw ?? _inputController.text;
+    if (text.isEmpty) return;
+    _inputController.clear();
+    // 管道回退时可能无回显，本地先显示一行。
+    setState(() => _output.write('$text\n'));
+    _scrollToEnd();
+    final payload = text.endsWith('\n') ? text : '$text\n';
+    await engine.sendInput(id, payload);
+    _inputFocus.requestFocus();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final active = _activeInfo;
+    final hasMux = active?.muxSession != null ||
+        (active?.backend?.startsWith('psmux') ?? false);
+
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        Text('远程终端', style: theme.textTheme.titleLarge),
+        const SizedBox(height: 4),
+        Text(
+          '通过会话数据通道在被控端打开命令行。关闭本面板仅分离显示，被控进程继续运行。'
+          'Windows 被控优先使用 ConPTY；若已安装 psmux 则支持多窗格，并可本机用 Windows Terminal 附着查看。',
+          style: theme.textTheme.bodySmall,
+        ),
+        if (_status != null) ...[
+          const SizedBox(height: 6),
+          Text(_status!, style: theme.textTheme.labelMedium),
+        ],
+        const SizedBox(height: 8),
+        Wrap(
+          spacing: 8,
+          runSpacing: 8,
+          children: [
+            FilledButton.icon(
+              onPressed: _busy ? null : _newSession,
+              icon: const Icon(Icons.add),
+              label: const Text('新建会话'),
+            ),
+            OutlinedButton.icon(
+              onPressed: _busy
+                  ? null
+                  : () async {
+                      await _engine?.list();
+                    },
+              icon: const Icon(Icons.refresh),
+              label: const Text('刷新'),
+            ),
+            OutlinedButton.icon(
+              onPressed: _busy || _activeId == null
+                  ? null
+                  : () => _splitPane(vertical: true),
+              icon: const Icon(Icons.horizontal_split),
+              label: const Text('垂直分屏'),
+            ),
+            OutlinedButton.icon(
+              onPressed: _busy || _activeId == null
+                  ? null
+                  : () => _splitPane(vertical: false),
+              icon: const Icon(Icons.vertical_split),
+              label: const Text('水平分屏'),
+            ),
+            OutlinedButton.icon(
+              onPressed:
+                  _busy || _activeId == null ? null : _visibleAttach,
+              icon: const Icon(Icons.open_in_new),
+              label: const Text('本机终端附着'),
+            ),
+          ],
+        ),
+        if (_activeId != null && !hasMux)
+          Padding(
+            padding: const EdgeInsets.only(top: 6),
+            child: Text(
+              '当前会话未走 psmux：分屏与共享附着需被控端安装 psmux（winget install psmux）。',
+              style: theme.textTheme.bodySmall,
+            ),
+          ),
+        if (_sessions.isNotEmpty) ...[
+          const SizedBox(height: 8),
+          SizedBox(
+            height: 40,
+            child: ListView.separated(
+              scrollDirection: Axis.horizontal,
+              itemCount: _sessions.length,
+              separatorBuilder: (_, __) => const SizedBox(width: 8),
+              itemBuilder: (context, i) {
+                final s = _sessions[i];
+                final selected = s.sessionId == _activeId;
+                final backend = s.backend != null ? ' · ${s.backend}' : '';
+                return InputChip(
+                  selected: selected,
+                  label: Text(
+                      '${s.name} (${_stateLabel(s.state)}$backend)'),
+                  onPressed: _busy ? null : () => _attach(s),
+                  onDeleted: _busy ? null : () => _kill(s),
+                  deleteIcon: const Icon(Icons.close, size: 16),
+                );
+              },
+            ),
+          ),
+        ],
+        const SizedBox(height: 8),
+        Expanded(
+          child: DecoratedBox(
+            decoration: BoxDecoration(
+              color: const Color(0xFF0F1115),
+              borderRadius: BorderRadius.circular(8),
+            ),
+            child: Scrollbar(
+              controller: _scrollController,
+              child: SingleChildScrollView(
+                controller: _scrollController,
+                padding: const EdgeInsets.all(12),
+                child: SelectableText(
+                  _output.isEmpty ? ' ' : _output.toString(),
+                  style: const TextStyle(
+                    fontFamily: 'monospace',
+                    fontSize: 12.5,
+                    height: 1.35,
+                    color: Color(0xFFE6EDF3),
+                  ),
+                ),
+              ),
+            ),
+          ),
+        ),
+        const SizedBox(height: 8),
+        TextField(
+          controller: _inputController,
+          focusNode: _inputFocus,
+          enabled: _activeId != null && !_busy,
+          style: const TextStyle(fontFamily: 'monospace'),
+          decoration: InputDecoration(
+            hintText: _activeId == null
+                ? '请先新建或附着会话'
+                : '输入命令后按 Enter',
+            border: const OutlineInputBorder(),
+            isDense: true,
+            suffixIcon: IconButton(
+              icon: const Icon(Icons.send),
+              onPressed:
+                  _activeId == null || _busy ? null : () => _submitInput(),
+            ),
+          ),
+          onSubmitted: (_) => _submitInput(),
+          textInputAction: TextInputAction.send,
+        ),
+        if (AppPlatform.isWeb)
+          Padding(
+            padding: const EdgeInsets.only(top: 6),
+            child: Text(
+              '网页端可作为主控使用；被控端须为桌面版（不支持 Web 被控）。',
+              style: theme.textTheme.bodySmall,
+            ),
+          ),
+      ],
+    );
+  }
+}

+#ifndef FLUTTER_WEBRTC_NAT_PUNCH_HXX
+#define FLUTTER_WEBRTC_NAT_PUNCH_HXX
+
+#include "flutter_common.h"
+
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace flutter_webrtc_plugin {
+
+// Bounded NAT punch helpers (replayable onto future flutter-webrtc).
+// Ideas only from hard-NAT ladder design — original implementation.
+class FlutterNatPunch {
+ public:
+  // UDP probes to public DNS-style hosts (port 53 by default).
+  static void ProbeFirewall(const EncodableMap& params,
+                            std::unique_ptr<MethodResultProxy> result);
+
+  // Multi-socket UDP bursts toward remote ICE candidate endpoints.
+  static void SymmetricPunch(const EncodableMap& params,
+                             std::unique_ptr<MethodResultProxy> result);
+};
+
+}  // namespace flutter_webrtc_plugin
+
+#endif  // FLUTTER_WEBRTC_NAT_PUNCH_HXX
diff --git a/plugins/flutter-webrtc/common/cpp/src/flutter_nat_punch.cc b/plugins/flutter-webrtc/common/cpp/src/flutter_nat_punch.cc
new file mode 100644
index 0000000..deadbeef
--- /dev/null
+++ b/plugins/flutter-webrtc/common/cpp/src/flutter_nat_punch.cc
@@ -0,0 +1,213 @@
+#include "flutter_nat_punch.h"
+
+#include <cctype>
+#include <chrono>
+#include <cstring>
+#include <thread>
+#include <vector>
+
+#if defined(_WIN32)
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#pragma comment(lib, "ws2_32.lib")
+using socket_t = SOCKET;
+static const socket_t kInvalidSocket = INVALID_SOCKET;
+static int CloseSocket(socket_t s) { return closesocket(s); }
+#else
+#include <arpa/inet.h>
+#include <fcntl.h>
+#include <netinet/in.h>
+#include <sys/socket.h>
+#include <unistd.h>
+using socket_t = int;
+static const socket_t kInvalidSocket = -1;
+static int CloseSocket(socket_t s) { return close(s); }
+#endif
+
+namespace flutter_webrtc_plugin {
+namespace {
+
+#if defined(_WIN32)
+struct WinsockLifetime {
+  WinsockLifetime() {
+    WSADATA wsa;
+    ready_ = (WSAStartup(MAKEWORD(2, 2), &wsa) == 0);
+  }
+  ~WinsockLifetime() {
+    if (ready_) WSACleanup();
+  }
+  bool ready_ = false;
+};
+#endif
+
+socket_t CreateUdpSocket() {
+#if defined(_WIN32)
+  static WinsockLifetime init;
+  if (!init.ready_) return kInvalidSocket;
+#endif
+  socket_t fd = ::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+  if (fd == kInvalidSocket) return kInvalidSocket;
+  sockaddr_in addr{};
+  addr.sin_family = AF_INET;
+  addr.sin_addr.s_addr = htonl(INADDR_ANY);
+  addr.sin_port = htons(0);
+  if (::bind(fd, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) != 0) {
+    CloseSocket(fd);
+    return kInvalidSocket;
+  }
+  return fd;
+}
+
+bool SendUdp(socket_t fd, const std::string& ip, int port,
+             const uint8_t* data, size_t len) {
+  sockaddr_in dest{};
+  dest.sin_family = AF_INET;
+  dest.sin_port = htons(static_cast<uint16_t>(port));
+  if (::inet_pton(AF_INET, ip.c_str(), &dest.sin_addr) != 1) {
+    return false;
+  }
+  int sent = ::sendto(fd, reinterpret_cast<const char*>(data),
+                      static_cast<int>(len), 0,
+                      reinterpret_cast<sockaddr*>(&dest), sizeof(dest));
+  return sent > 0;
+}
+
+// Mirror Dart IceCandidateEndpoint.isPublicUnicastIpv4 — reject private /
+// loopback / link-local / CGNAT / multicast so MethodChannel callers cannot
+// steer bursts at arbitrary internal destinations.
+// Manual IPv4 parse — avoid MSVC C4996 on sscanf under /WX.
+bool IsPublicUnicastIpv4(const std::string& ip) {
+  unsigned octets[4] = {0, 0, 0, 0};
+  size_t i = 0;
+  for (int oi = 0; oi < 4; ++oi) {
+    if (i >= ip.size() || !isdigit(static_cast<unsigned char>(ip[i]))) {
+      return false;
+    }
+    unsigned v = 0;
+    const size_t start = i;
+    while (i < ip.size() && isdigit(static_cast<unsigned char>(ip[i]))) {
+      v = v * 10u + static_cast<unsigned>(ip[i] - '0');
+      if (v > 255) return false;
+      ++i;
+    }
+    if (i == start) return false;
+    octets[oi] = v;
+    if (oi < 3) {
+      if (i >= ip.size() || ip[i] != '.') return false;
+      ++i;
+    }
+  }
+  if (i != ip.size()) return false;
+  const unsigned a = octets[0], b = octets[1];
+  if (a == 0 || a == 127) return false;
+  if (a == 10) return false;
+  if (a == 172 && b >= 16 && b <= 31) return false;
+  if (a == 192 && b == 168) return false;
+  if (a == 169 && b == 254) return false;
+  if (a == 100 && b >= 64 && b <= 127) return false;
+  if (a >= 224) return false;
+  return true;
+}
+
+}  // namespace
+
+void FlutterNatPunch::ProbeFirewall(
+    const EncodableMap& params,
+    std::unique_ptr<MethodResultProxy> result) {
+  EncodableList hosts_enc = findList(params, "hosts");
+  int port = findInt(params, "port");
+  if (port <= 0) port = 53;
+
+  std::vector<std::string> reachable;
+  uint8_t payload[1] = {0x00};
+
+  for (const auto& h : hosts_enc) {
+    if (!TypeIs<std::string>(h)) continue;
+    std::string host = GetValue<std::string>(h);
+    socket_t fd = CreateUdpSocket();
+    if (fd == kInvalidSocket) continue;
+    if (SendUdp(fd, host, port, payload, sizeof(payload))) {
+      reachable.push_back(host);
+    }
+    CloseSocket(fd);
+  }
+
+  EncodableList out_hosts;
+  for (const auto& h : reachable) {
+    out_hosts.push_back(EncodableValue(h));
+  }
+  EncodableMap out;
+  out[EncodableValue("reachableHosts")] = EncodableValue(out_hosts);
+  out[EncodableValue("supported")] = EncodableValue(true);
+  result->Success(EncodableValue(out));
+}
+
+void FlutterNatPunch::SymmetricPunch(
+    const EncodableMap& params,
+    std::unique_ptr<MethodResultProxy> result) {
+  EncodableList targets = findList(params, "targets");
+  int socket_count = findInt(params, "socketCount");
+  int packets_per_socket = findInt(params, "packetsPerSocket");
+  int interval_ms = findInt(params, "intervalMs");
+  if (socket_count <= 0) socket_count = 8;
+  if (packets_per_socket <= 0) packets_per_socket = 4;
+  if (interval_ms < 0) interval_ms = 20;
+  if (interval_ms > 200) interval_ms = 200;
+  if (socket_count > 32) socket_count = 32;
+  if (packets_per_socket > 16) packets_per_socket = 16;
+
+  struct Target {
+    std::string ip;
+    int port = 0;
+  };
+  std::vector<Target> parsed;
+  static const size_t kMaxTargetsPerBurst = 8;
+  for (const auto& t : targets) {
+    if (parsed.size() >= kMaxTargetsPerBurst) break;
+    if (!TypeIs<EncodableMap>(t)) continue;
+    const EncodableMap& m = GetValue<EncodableMap>(t);
+    std::string ip = findString(m, "ip");
+    int port = findInt(m, "port");
+    if (ip.empty() || port <= 0 || port > 65535) continue;
+    if (!IsPublicUnicastIpv4(ip)) continue;
+    parsed.push_back(Target{ip, port});
+  }
+
+  // Reply on the platform thread immediately, then burst on a worker so
+  // sleep_for cannot stall Flutter UI / MethodChannel signaling.
+  const int planned_packets =
+      static_cast<int>(parsed.size()) * socket_count * packets_per_socket;
+  EncodableMap out;
+  out[EncodableValue("supported")] = EncodableValue(true);
+  out[EncodableValue("targetsAttempted")] =
+      EncodableValue(static_cast<int>(parsed.size()));
+  out[EncodableValue("packetsSent")] = EncodableValue(planned_packets);
+  result->Success(EncodableValue(out));
+
+  if (parsed.empty() || socket_count <= 0 || packets_per_socket <= 0) {
+    return;
+  }
+
+  std::thread([parsed, socket_count, packets_per_socket, interval_ms]() {
+    std::vector<socket_t> sockets;
+    sockets.reserve(static_cast<size_t>(socket_count));
+    for (int i = 0; i < socket_count; i++) {
+      socket_t fd = CreateUdpSocket();
+      if (fd != kInvalidSocket) sockets.push_back(fd);
+    }
+
+    uint8_t payload[20];
+    std::memset(payload, 0, sizeof(payload));
+    payload[0] = 0x00;
+    payload[1] = 0x01;  // STUN Binding Request type hint
+
+    for (int p = 0; p < packets_per_socket; p++) {
+      for (socket_t fd : sockets) {
+        for (const auto& ep : parsed) {
+          int port = ep.port;
+          if (p > 0) {
+            port = ep.port + ((p % 5) - 2);
+            if (port < 1) port = 1;
+            if (port > 65535) port = 65535;
+          }
+          SendUdp(fd, ep.ip, port, payload, sizeof(payload));
+        }
+      }
+      if (p + 1 < packets_per_socket && interval_ms > 0) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(interval_ms));
+      }
+    }
+
+    for (socket_t fd : sockets) {
+      CloseSocket(fd);
+    }
+  }).detach();
+}
+
+}  // namespace flutter_webrtc_plugin

new file mode 100644
index 0000000..dea8479
--- /dev/null
+++ b/plugins/flutter-webrtc/lib/src/native/nat_punch.dart
@@ -0,0 +1,59 @@
+import 'package:flutter/services.dart';
+
+import 'utils.dart';
+
+/// Thin MethodChannel for enhanced NAT punch (firewall probe + symmetric burst).
+///
+/// Channel methods (ABI freeze — see patches/nat-punch/FILE_LIST.md):
+/// - `natPunchProbeFirewall`
+/// - `natPunchSymmetric`
+///
+/// Returns null when the native plugin does not implement the method (older
+/// builds); callers must fall back to Dart [RawDatagramSocket] punch.
+class NatPunch {
+  static Future<Map<String, dynamic>?> probeFirewall({
+    required List<String> hosts,
+    int port = 53,
+    int timeoutMs = 800,
+  }) async {
+    try {
+      final result = await WebRTC.invokeMethod('natPunchProbeFirewall', {
+        'hosts': hosts,
+        'port': port,
+        'timeoutMs': timeoutMs,
+      });
+      if (result is Map) {
+        return Map<String, dynamic>.from(result);
+      }
+      return null;
+    } on MissingPluginException {
+      return null;
+    } on PlatformException {
+      return null;
+    }
+  }
+
+  static Future<Map<String, dynamic>?> symmetricPunch({
+    required List<Map<String, dynamic>> targets,
+    int socketCount = 8,
+    int packetsPerSocket = 4,
+    int intervalMs = 20,
+  }) async {
+    try {
+      final result = await WebRTC.invokeMethod('natPunchSymmetric', {
+        'targets': targets,
+        'socketCount': socketCount,
+        'packetsPerSocket': packetsPerSocket,
+        'intervalMs': intervalMs,
+      });
+      if (result is Map) {
+        return Map<String, dynamic>.from(result);
+      }
+      return null;
+    } on MissingPluginException {
+      return null;
+    } on PlatformException {
+      return null;
+    }
+  }
+}

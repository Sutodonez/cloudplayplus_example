+/// Capture a modifier+key dismiss hotkey for privacy blank display.
+class _PrivacyHotkeyCaptureDialog extends StatefulWidget {
+  const _PrivacyHotkeyCaptureDialog();
+
+  @override
+  State<_PrivacyHotkeyCaptureDialog> createState() =>
+      _PrivacyHotkeyCaptureDialogState();
+}
+
+class _PrivacyHotkeyCaptureDialogState
+    extends State<_PrivacyHotkeyCaptureDialog> {
+  String _hint = '请按下组合键（需含 Ctrl / Alt / Shift / Win 之一）';
+
+  KeyEventResult _onKey(FocusNode node, KeyEvent event) {
+    if (event is! KeyDownEvent) return KeyEventResult.handled;
+    final key = event.logicalKey;
+    if (key == LogicalKeyboardKey.controlLeft ||
+        key == LogicalKeyboardKey.controlRight ||
+        key == LogicalKeyboardKey.altLeft ||
+        key == LogicalKeyboardKey.altRight ||
+        key == LogicalKeyboardKey.shiftLeft ||
+        key == LogicalKeyboardKey.shiftRight ||
+        key == LogicalKeyboardKey.metaLeft ||
+        key == LogicalKeyboardKey.metaRight) {
+      return KeyEventResult.handled;
+    }
+
+    final vk = _logicalKeyToVk(key);
+    if (vk == null) {
+      setState(() => _hint = '不支持该按键，请换字母 / 数字 / F 键');
+      return KeyEventResult.handled;
+    }
+
+    var mods = 0;
+    if (HardwareKeyboard.instance.isControlPressed) {
+      mods |= PrivacyHotkeyModifiers.ctrl;
+    }
+    if (HardwareKeyboard.instance.isAltPressed) {
+      mods |= PrivacyHotkeyModifiers.alt;
+    }
+    if (HardwareKeyboard.instance.isShiftPressed) {
+      mods |= PrivacyHotkeyModifiers.shift;
+    }
+    if (HardwareKeyboard.instance.isMetaPressed) {
+      mods |= PrivacyHotkeyModifiers.win;
+    }
+    if (mods == 0) {
+      setState(() => _hint = '请同时按住修饰键（Ctrl / Alt / Shift / Win）');
+      return KeyEventResult.handled;
+    }
+
+    final hotkey = PrivacyHotkey(modifiers: mods, keyCode: vk);
+    Navigator.of(context).pop(hotkey);
+    return KeyEventResult.handled;
+  }
+
+  int? _logicalKeyToVk(LogicalKeyboardKey key) {
+    final label = key.keyLabel;
+    if (label.length == 1) {
+      final c = label.toUpperCase().codeUnitAt(0);
+      if ((c >= 0x30 && c <= 0x39) || (c >= 0x41 && c <= 0x5A)) {
+        return c;
+      }
+    }
+    // Non-const: LogicalKeyboardKey lacks primitive equality for const maps.
+    final fKeys = <LogicalKeyboardKey, int>{
+      LogicalKeyboardKey.f1: 0x70,
+      LogicalKeyboardKey.f2: 0x71,
+      LogicalKeyboardKey.f3: 0x72,
+      LogicalKeyboardKey.f4: 0x73,
+      LogicalKeyboardKey.f5: 0x74,
+      LogicalKeyboardKey.f6: 0x75,
+      LogicalKeyboardKey.f7: 0x76,
+      LogicalKeyboardKey.f8: 0x77,
+      LogicalKeyboardKey.f9: 0x78,
+      LogicalKeyboardKey.f10: 0x79,
+      LogicalKeyboardKey.f11: 0x7A,
+      LogicalKeyboardKey.f12: 0x7B,
+    };
+    return fKeys[key];
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Focus(
+      autofocus: true,
+      onKeyEvent: _onKey,
+      child: AlertDialog(
+        title: const Text('设置解除热键'),
+        content: Text(_hint),
+        actions: [
+          TextButton(
+            onPressed: () => Navigator.of(context).pop(),
+            child: const Text('取消'),
+          ),
+          TextButton(
+            onPressed: () =>
+                Navigator.of(context).pop(PrivacyHotkey.defaultHotkey),
+            child: const Text('恢复默认'),
+          ),
+        ],
+      ),
+    );
+  }
+}

diff --git a/lib/services/privacy_blank_service.dart b/lib/services/privacy_blank_service.dart
new file mode 100644
index 0000000..99ca053
--- /dev/null
+++ b/lib/services/privacy_blank_service.dart
@@ -0,0 +1,248 @@
+import 'dart:async';
+
+import 'package:cloudplayplus/base/constants.dart';
+import 'package:cloudplayplus/base/logging.dart';
+import 'package:cloudplayplus/global_settings/streaming_settings.dart';
+import 'package:cloudplayplus/services/app_info_service.dart';
+import 'package:cloudplayplus/services/shared_preferences_manager.dart';
+import 'package:privacy_blank_display/privacy_blank_display.dart';
+
+/// Host-side privacy / blank-display orchestrator.
+///
+/// Product rule (Q22): **host settings are the default**; a controller may
+/// temporarily override for a session (including force-off) **only when** the
+/// host setting [StreamingSettings.privacyAllowControllerOverride] is true.
+/// Mid-session opcode requests use the same gate.
+///
+/// Applies [PrivacyBlankMode] while at least one inbound stream session is
+/// active (when auto-on / override), and restores [PrivacyBlankMode.off] when
+/// the last session ends — unless the user dismissed via the host hotkey.
+class PrivacyBlankService {
+  PrivacyBlankService._();
+
+  static bool _initialized = false;
+  static bool _sessionEngaged = false;
+  static bool _dismissedThisSession = false;
+  static StreamSubscription<void>? _dismissSub;
+  static PrivacyBlankMode _active = PrivacyBlankMode.off;
+
+  static PrivacyBlankMode get activeMode => _active;
+
+  static Future<void> init() async {
+    if (_initialized) return;
+    _initialized = true;
+    if (!AppPlatform.isWindows) return;
+
+    await PrivacyBlankDisplay.setDismissLocksHost(
+        StreamingSettings.privacyDismissLocks);
+    await _applyStoredHotkey();
+    _dismissSub ??= PrivacyBlankDisplay.onDismissedByHotkey.listen((_) {
+      _dismissedThisSession = true;
+      _sessionEngaged = false;
+      _active = PrivacyBlankMode.off;
+      VLOG0('Privacy blank dismissed by host hotkey');
+    });
+  }
+
+  static Future<void> _applyStoredHotkey() async {
+    final raw = PrivacyHotkey(
+      modifiers: StreamingSettings.privacyHotkeyModifiers,
+      keyCode: StreamingSettings.privacyHotkeyVk,
+    );
+    final hotkey = raw.sanitized();
+    if (!raw.isValid || hotkey.modifiers != raw.modifiers) {
+      StreamingSettings.privacyHotkeyModifiers = hotkey.modifiers;
+      StreamingSettings.privacyHotkeyVk = hotkey.keyCode;
+      await SharedPreferencesManager.setInt(
+          'privacyHotkeyModifiers', hotkey.modifiers);
+      await SharedPreferencesManager.setInt('privacyHotkeyVk', hotkey.keyCode);
+      VLOG0('Privacy hotkey prefs sanitized to ${hotkey.label}');
+    }
+    final ok = await PrivacyBlankDisplay.setHotkey(hotkey);
+    if (!ok) {
+      VLOG0('Privacy hotkey register failed: ${hotkey.label}');
+    }
+  }
+
+  static PrivacyBlankMode modeFromIndex(int? index) {
+    if (index == null || index < 0 || index >= PrivacyBlankMode.values.length) {
+      return PrivacyBlankMode.off;
+    }
+    return PrivacyBlankMode.values[index];
+  }
+
+  /// Whether the host currently permits controller privacy overrides (Q22).
+  static bool get allowsControllerOverride =>
+      StreamingSettings.privacyAllowControllerOverride;
+
+  /// Drop a controller-supplied mode when host policy forbids override.
+  /// Returns null when the request must be ignored (use host default instead).
+  static int? acceptedControllerRequest(int? requestedMode) {
+    if (requestedMode == null) return null;
+    if (!allowsControllerOverride) {
+      VLOG0(
+          'privacy controller override rejected by host policy '
+          '(requested=$requestedMode)');
+      return null;
+    }
+    return requestedMode;
+  }
+
+  /// Resolve effective mode for a new inbound session.
+  ///
+  /// * If [requestedMode] is non-null **and** host allows override →
+  ///   controller temporary override (0 = force off for this session).
+  /// * Otherwise → host [StreamingSettings.privacyMode] default.
+  static PrivacyBlankMode resolveModeForSession({int? requestedMode}) {
+    final accepted = acceptedControllerRequest(requestedMode);
+    if (accepted != null) {
+      return modeFromIndex(accepted);
+    }
+    return modeFromIndex(StreamingSettings.privacyMode);
+  }
+
+  /// Whether privacy should engage for this session (auto-on or override).
+  static bool shouldEngageForSession({int? requestedMode}) {
+    if (_dismissedThisSession) return false;
+    final accepted = acceptedControllerRequest(requestedMode);
+    final auto = StreamingSettings.privacyAutoOnConnect;
+    if (!auto && accepted == null) return false;
+    return resolveModeForSession(requestedMode: requestedMode) !=
+        PrivacyBlankMode.off;
+  }
+
+  /// When blankDisplay will engage, optionally force exclusive virtual-display
+  /// path (`VDISPLAY_OCCUPY`) so the desktop moves onto the VDD (Q21).
+  ///
+  /// Topology rewrite requires [StreamingSettings.privacyAutoBindExclusive].
+  /// Effective mode still respects the controller-override host gate.
+  ///
+  /// Returns true if [settings.streamMode] was changed.
+  static bool ensureExclusiveForBlankDisplay(StreamedSettings settings) {
+    if (!StreamingSettings.privacyAutoBindExclusive) {
+      VLOG0('blankDisplay exclusive auto-bind disabled by host policy');
+      return false;
+    }
+    // Uses resolveModeForSession so a rejected controller request still
+    // follows the host blankDisplay default (does not silently skip bind).
+    final mode =
+        resolveModeForSession(requestedMode: settings.privacyMode);
+    final engage = shouldEngageForSession(requestedMode: settings.privacyMode);
+    if (!engage || mode != PrivacyBlankMode.blankDisplay) {
+      return false;
+    }
+    if (settings.streamMode == VDISPLAY_OCCUPY) {
+      return false;
+    }
+    settings.streamMode = VDISPLAY_OCCUPY;
+    settings.customScreenWidth ??= StreamingSettings.customScreenWidth;
+    settings.customScreenHeight ??= StreamingSettings.customScreenHeight;
+    // Occupy path keys VDD by screenId then rewrites it to 0 after primary-only.
+    settings.screenId = 0;
+    VLOG0(
+        'blankDisplay auto-bound to VDISPLAY_OCCUPY '
+        '(${settings.customScreenWidth}x${settings.customScreenHeight})');
+    return true;
+  }
+
+  static Future<bool> applyMode(PrivacyBlankMode mode) async {
+    await init();
+    if (!AppPlatform.isWindows) return false;
+    final supported = await PrivacyBlankDisplay.isSupported();
+    if (!supported) return false;
+
+    await PrivacyBlankDisplay.setDismissLocksHost(
+        StreamingSettings.privacyDismissLocks);
+    await _applyStoredHotkey();
+    final ok = await PrivacyBlankDisplay.setMode(mode);
+    if (ok) {
+      _active = mode;
+      _sessionEngaged = mode != PrivacyBlankMode.off;
+      if (mode != PrivacyBlankMode.off) {
+        _dismissedThisSession = false;
+      }
+      VLOG0('Privacy blank mode -> $mode');
+    } else {
+      // Keep Dart `_active` aligned with native: failed setMode must not
+      // leave host muted/hotkey-only (native rolls back on overlay failure).
+      VLOG0('Privacy blank mode apply failed: $mode');
+    }
+    return ok;
+  }
+
+  /// Apply a controller-requested mid-session mode subject to host policy.
+  /// Returns false when rejected or native apply fails.
+  static Future<bool> applyControllerMode(PrivacyBlankMode mode) async {
+    if (!allowsControllerOverride) {
+      VLOG0('LP_PRIVACY_MODE rejected: host disallows controller override');
+      return false;
+    }
+    return applyMode(mode);
+  }
+
+  /// Called when an inbound streaming session becomes active.
+  static Future<void> onSessionStarted({int? requestedMode}) async {
+    await init();
+    if (!AppPlatform.isWindows) return;
+    if (!shouldEngageForSession(requestedMode: requestedMode)) return;
+
+    final mode = resolveModeForSession(requestedMode: requestedMode);
+    if (mode == PrivacyBlankMode.off) return;
+    if (_sessionEngaged && _active == mode) return;
+    await applyMode(mode);
+  }
+
+  /// Called when the last inbound streaming session ends.
+  static Future<void> onAllSessionsEnded() async {
+    await init();
+    _dismissedThisSession = false;
+    if (_active == PrivacyBlankMode.off) {
+      _sessionEngaged = false;
+      return;
+    }
+    await applyMode(PrivacyBlankMode.off);
+
+    if (StreamingSettings.privacyLockOnDisconnect && AppPlatform.isWindows) {
+      final locked = await PrivacyBlankDisplay.lockWorkstation();
+      VLOG0('privacyLockOnDisconnect lockWorkstation=$locked');
+    }
+  }
+
+  static Future<void> persistHostDefaults({
+    required int mode,
+    required bool autoOnConnect,
+    required bool dismissLocks,
+    required bool lockOnDisconnect,
+    required int hotkeyModifiers,
+    required int hotkeyVk,
+    required bool allowControllerOverride,
+    required bool autoBindExclusive,
+  }) async {
+    final hotkey = PrivacyHotkey(
+      modifiers: hotkeyModifiers,
+      keyCode: hotkeyVk,
+    ).sanitized();
+    StreamingSettings.privacyMode = mode;
+    StreamingSettings.privacyAutoOnConnect = autoOnConnect;
+    StreamingSettings.privacyDismissLocks = dismissLocks;
+    StreamingSettings.privacyLockOnDisconnect = lockOnDisconnect;
+    StreamingSettings.privacyHotkeyModifiers = hotkey.modifiers;
+    StreamingSettings.privacyHotkeyVk = hotkey.keyCode;
+    StreamingSettings.privacyAllowControllerOverride = allowControllerOverride;
+    StreamingSettings.privacyAutoBindExclusive = autoBindExclusive;
+    await SharedPreferencesManager.setInt('privacyMode', mode);
+    await SharedPreferencesManager.setBool('privacyAutoOnConnect', autoOnConnect);
+    await SharedPreferencesManager.setBool('privacyDismissLocks', dismissLocks);
+    await SharedPreferencesManager.setBool(
+        'privacyLockOnDisconnect', lockOnDisconnect);
+    await SharedPreferencesManager.setInt(
+        'privacyHotkeyModifiers', hotkey.modifiers);
+    await SharedPreferencesManager.setInt('privacyHotkeyVk', hotkey.keyCode);
+    await SharedPreferencesManager.setBool(
+        'privacyAllowControllerOverride', allowControllerOverride);
+    await SharedPreferencesManager.setBool(
+        'privacyAutoBindExclusive', autoBindExclusive);
+    await PrivacyBlankDisplay.setDismissLocksHost(dismissLocks);
+    await PrivacyBlankDisplay.setHotkey(hotkey);
+  }
+}

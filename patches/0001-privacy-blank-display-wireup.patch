+                ),
+                SettingsTile(
+                  title: const Text('关闭显示屏 (blank display)'),
+                  description: const Text(
+                    '关闭物理屏背光。更强的虚拟屏独占可用连接「独占模式」。',
+                  ),
+                  leading: Icon(
+                    Icons.check,
+                    color: _mode == 1 ? Colors.blue : Colors.transparent,
+                  ),
+                  onPressed: (_) async {
+                    setState(() => _mode = 1);
+                    await _persist();
+                  },
+                ),
+                SettingsTile(
+                  title: const Text('隐私屏保 (privacy screen)'),
+                  description: const Text(
+                    '物理屏黑屏遮罩，捕获排除遮罩 (WDA_EXCLUDEFROMCAPTURE)。',

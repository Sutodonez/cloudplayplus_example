+                    setState(() => _mode = 2);
+                    await _persist();
+                  },
+                ),
+              ],
+            ),
+            SettingsSection(
+              title: const Text('行为'),
+              tiles: [
+                SettingsTile.switchTile(
+                  title: const Text('被控连接时自动开启'),
+                  leading: const Icon(Icons.play_circle_outline),
+                  initialValue: _autoOn,

+    _dismissLocks = StreamingSettings.privacyDismissLocks;
+    _lockOnDisconnect = StreamingSettings.privacyLockOnDisconnect;
+  }
+
+  Future<void> _persist() async {
+    await PrivacyBlankService.persistHostDefaults(

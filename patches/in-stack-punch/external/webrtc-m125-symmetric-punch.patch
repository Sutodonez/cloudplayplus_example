+int BasicPortAllocatorSession::SymmetricPunchToRemotes(
+    const std::vector<rtc::SocketAddress>& remotes,
+    size_t bursts_per_endpoint) {
+  RTC_DCHECK_RUN_ON(network_thread_);
+  if (remotes.empty() || bursts_per_endpoint == 0) {
+    return 0;
+  }
+  // Minimal payload; content does not matter for hole punching.
+  static constexpr char kPunchPayload[] = "CPP_SYM_PUNCH";
+  int attempts = 0;
+  for (PortInterface* port : ReadyPorts()) {
+    if (!port) {
+      continue;
+    }
+    // Prefer UDP host/srflx ports; skip relays for punch bursts.
+    if (port->GetProtocol() != PROTO_UDP) {
+      continue;
+    }
+    for (const rtc::SocketAddress& remote : remotes) {
+      for (size_t i = 0; i < bursts_per_endpoint; ++i) {
+        rtc::PacketOptions options;
+        const int sent = port->SendTo(kPunchPayload, sizeof(kPunchPayload) - 1,
+                                      remote, options, false);
+        if (sent >= 0) {
+          ++attempts;
+        }
+      }
+    }
+  }
+  RTC_LOG(LS_INFO) << "SymmetricPunchToRemotes issued " << attempts
+                   << " SendTo attempts toward " << remotes.size()
+                   << " remote(s)";
+  return attempts;
+}

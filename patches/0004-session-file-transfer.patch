@@ -0,0 +1,94 @@
+import 'package:cloudplayplus/services/app_info_service.dart';
+import 'package:cloudplayplus/services/shared_preferences_manager.dart';
+import 'package:cloudplayplus/services/streaming_manager.dart';
+import 'package:file_picker/file_picker.dart';
+import 'package:flutter/material.dart';
+import 'package:session_file_transfer/session_file_transfer.dart';
+
+/// Host-side file transfer preferences (auto-accept + save path).
+class FileTransferSettingsScreen extends StatefulWidget {
+  const FileTransferSettingsScreen({super.key});
+
+  @override
+  State<FileTransferSettingsScreen> createState() =>
+      _FileTransferSettingsScreenState();
+}
+
+class _FileTransferSettingsScreenState
+    extends State<FileTransferSettingsScreen> {
+  bool _autoAccept = true;
+  String _savePath = '';
+
+  @override
+  void initState() {
+    super.initState();
+    _autoAccept =
+        SharedPreferencesManager.getBool('fileXferAutoAccept') ?? true;
+    _savePath = SharedPreferencesManager.getString('fileXferSavePath') ?? '';
+    if (_savePath.isEmpty) {
+      _savePath = defaultReceiveRoot();
+    }
+  }
+
+  Future<void> _persist() async {
+    await SharedPreferencesManager.setBool('fileXferAutoAccept', _autoAccept);
+    await SharedPreferencesManager.setString('fileXferSavePath', _savePath);
+    // Reload engines on any active sessions so prefs take effect.
+    for (final session in StreamingManager.sessions.values) {
+      await session.reloadFileTransferSettings();
+    }
+  }
+
+  Future<void> _pickSavePath() async {
+    if (AppPlatform.isWeb) {
+      ScaffoldMessenger.of(context).showSnackBar(
+        const SnackBar(content: Text('网页端不能配置被控端落盘路径')),
+      );
+      return;
+    }
+    final dir = await FilePicker.platform.getDirectoryPath(
+      dialogTitle: '选择文件接收保存目录',
+    );
+    if (dir == null) return;
+    setState(() => _savePath = dir);
+    await _persist();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Scaffold(
+      appBar: AppBar(title: const Text('文件传输')),
+      body: ListView(
+        children: [
+          SwitchListTile(
+            secondary: const Icon(Icons.file_download_done),
+            title: const Text('自动接收文件'),
+            subtitle: const Text('关闭后，收到对方发送请求时需手动确认'),
+            value: _autoAccept,
+            onChanged: AppPlatform.isWeb
+                ? null
+                : (v) async {
+                    setState(() => _autoAccept = v);
+                    await _persist();
+                  },
+          ),
+          ListTile(
+            leading: const Icon(Icons.folder_open),
+            title: const Text('保存目录'),
+            subtitle: Text(_savePath),
+            trailing: const Icon(Icons.edit),
+            onTap: AppPlatform.isWeb ? null : _pickSavePath,
+          ),
+          const Padding(
+            padding: EdgeInsets.all(16),
+            child: Text(
+              '默认目录为 Downloads/CloudPlayPlusTransfers。'
+              '合并前可配置；网页控制端只负责发送，落盘在被控端生效。',
+              style: TextStyle(fontSize: 13),
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+}
diff --git a/lib/utils/widgets/file_transfer_sheet.dart b/lib/utils/widgets/file_transfer_sheet.dart
new file mode 100644
index 0000000..ac30394
--- /dev/null
+++ b/lib/utils/widgets/file_transfer_sheet.dart
@@ -0,0 +1,227 @@
+import 'dart:async';
+import 'dart:typed_data';
+
+import 'package:cloudplayplus/entities/session.dart';
+import 'package:cloudplayplus/services/app_info_service.dart';
+import 'package:cloudplayplus/services/webrtc_service.dart';
+import 'package:cloudplayplus/utils/widgets/message_box.dart';
+import 'package:file_picker/file_picker.dart';
+import 'package:flutter/material.dart';
+import 'package:session_file_transfer/session_file_transfer.dart';
+
+/// Minimal send UI for session file transfer (controller side).
+///
+/// Desktop: path-based pick + folder send.
+/// Web: memory-backed file pick (withData); folder send not available.
+class FileTransferSheet {
+  static Future<void> show(BuildContext context) async {
+    final session = WebrtcService.currentRenderingSession;
+    if (session == null ||
+        session.connectionState != StreamingSessionConnectionState.connected) {
+      MessageBoxManager().showMessage('当前没有已连接的会话', '文件传输');
+      return;
+    }
+
+    await showModalBottomSheet<void>(
+      context: context,
+      showDragHandle: true,
+      builder: (ctx) {
+        return SafeArea(
+          child: Padding(
+            padding: const EdgeInsets.fromLTRB(20, 8, 20, 24),
+            child: _FileTransferBody(session: session),
+          ),
+        );
+      },
+    );
+  }
+}
+
+class _FileTransferBody extends StatefulWidget {
+  final StreamingSession session;
+
+  const _FileTransferBody({required this.session});
+
+  @override
+  State<_FileTransferBody> createState() => _FileTransferBodyState();
+}
+
+class _FileTransferBodyState extends State<_FileTransferBody> {
+  FileTransferProgress? _progress;
+  StreamSubscription<FileTransferProgress>? _sub;
+  bool _busy = false;
+
+  @override
+  void initState() {
+    super.initState();
+    // reloadFileTransferSettings no-ops when prefs are unchanged, so opening
+    // the sheet does not dispose/abort an in-flight transfer.
+    unawaited(() async {
+      await widget.session.reloadFileTransferSettings();
+      if (!mounted) return;
+      await _attachProgress();
+    }());
+  }
+
+  @override
+  void dispose() {
+    _sub?.cancel();
+    super.dispose();
+  }
+
+  Future<void> _attachProgress() async {
+    await _sub?.cancel();
+    final engine = widget.session.fileTransfer;
+    if (engine != null) {
+      _sub = engine.progress.listen((p) {
+        if (mounted) setState(() => _progress = p);
+      });
+    }
+  }
+
+  Future<void> _pickAndSendFiles() async {
+    setState(() => _busy = true);
+    try {
+      if (AppPlatform.isWeb) {
+        final result = await FilePicker.platform.pickFiles(
+          allowMultiple: true,
+          withData: true,
+          dialogTitle: '选择要发送的文件',
+        );
+        if (result == null) return;
+        final files = <({String relativePath, Uint8List bytes})>[];
+        for (final f in result.files) {
+          final bytes = f.bytes;
+          if (bytes == null) continue;
+          files.add((relativePath: f.name, bytes: bytes));
+        }
+        if (files.isEmpty) {
+          MessageBoxManager().showMessage('未能读取所选文件内容', '发送失败');
+          return;
+        }
+        await widget.session.sendFileBytes(files);
+      } else {
+        final result = await FilePicker.platform.pickFiles(
+          allowMultiple: true,
+          withData: false,
+          dialogTitle: '选择要发送的文件',
+        );
+        if (result == null) return;
+        final paths = <String>[];
+        for (final f in result.files) {
+          if (f.path != null) paths.add(f.path!);
+        }
+        if (paths.isEmpty) return;
+        await widget.session.sendFiles(paths);
+      }
+      await _attachProgress();
+    } catch (e) {
+      MessageBoxManager().showMessage(e.toString(), '发送失败');
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  Future<void> _pickAndSendFolder() async {
+    if (AppPlatform.isWeb) {
+      MessageBoxManager().showMessage(
+        '网页端暂不支持发送整个文件夹，请改选多个文件。',
+        '文件传输',
+      );
+      return;
+    }
+    setState(() => _busy = true);
+    try {
+      final dir = await FilePicker.platform.getDirectoryPath(
+        dialogTitle: '选择要发送的文件夹',
+      );
+      if (dir == null) return;
+      await widget.session.sendFiles([dir]);
+      await _attachProgress();
+    } catch (e) {
+      MessageBoxManager().showMessage(e.toString(), '发送失败');
+    } finally {
+      if (mounted) setState(() => _busy = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final p = _progress;
+    return Column(
+      mainAxisSize: MainAxisSize.min,
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        Text('会话文件传输', style: Theme.of(context).textTheme.titleLarge),
+        const SizedBox(height: 4),
+        Text(
+          AppPlatform.isWeb
+              ? '通过当前远程会话发送文件（网页控制端）。被控端保存路径可在设置中配置。'
+              : '通过当前远程会话的可靠数据通道发送文件或文件夹。被控端保存路径与自动接收可在设置中配置。',
+          style: Theme.of(context).textTheme.bodySmall,
+        ),
+        const SizedBox(height: 16),
+        FilledButton.icon(
+          onPressed: _busy ? null : _pickAndSendFiles,
+          icon: const Icon(Icons.insert_drive_file_outlined),
+          label: const Text('发送文件'),
+        ),
+        const SizedBox(height: 8),
+        OutlinedButton.icon(
+          onPressed: _busy ? null : _pickAndSendFolder,
+          icon: const Icon(Icons.folder_outlined),
+          label: const Text('发送文件夹'),
+        ),
+        if (p != null) ...[
+          const SizedBox(height: 16),
+          LinearProgressIndicator(value: p.bytesTotal > 0 ? p.fraction : null),
+          const SizedBox(height: 8),
+          Text(
+            '${_stateLabel(p.state)}  ${p.fileIndex + 1}/${p.fileCount}'
+            '${p.currentPath != null ? '  ${p.currentPath}' : ''}',
+            maxLines: 2,
+            overflow: TextOverflow.ellipsis,
+          ),
+          Text(
+            '${_fmt(p.bytesTransferred)} / ${_fmt(p.bytesTotal)}'
+            '${p.isIncoming ? '  (接收)' : '  (发送)'}',
+          ),
+          if (p.state == FileTransferState.transferring ||
+              p.state == FileTransferState.offering)
+            TextButton(
+              onPressed: () =>
+                  widget.session.fileTransfer?.abort(reason: 'user abort'),
+              child: const Text('取消'),
+            ),
+        ],
+      ],
+    );
+  }
+
+  static String _stateLabel(FileTransferState s) {
+    switch (s) {
+      case FileTransferState.offering:
+        return '等待对方接受';
+      case FileTransferState.transferring:
+        return '传输中';
+      case FileTransferState.completed:
+        return '已完成';
+      case FileTransferState.aborted:
+        return '已取消';
+      case FileTransferState.failed:
+        return '失败';
+      case FileTransferState.paused:
+        return '暂停';
+      case FileTransferState.idle:
+        return '空闲';
+    }
+  }
+
+  static String _fmt(int bytes) {
+    if (bytes < 1024) return '$bytes B';
+    if (bytes < 1024 * 1024) {
+      return '${(bytes / 1024).toStringAsFixed(1)} KB';
+    }
+    return '${(bytes / (1024 * 1024)).toStringAsFixed(1)} MB';
+  }
+}

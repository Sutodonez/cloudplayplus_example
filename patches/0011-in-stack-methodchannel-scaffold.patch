@@ -0,0 +1,24 @@
+#ifndef FLUTTER_WEBRTC_NAT_PUNCH_IN_STACK_HXX
+#define FLUTTER_WEBRTC_NAT_PUNCH_IN_STACK_HXX
+
+// CPPS pin A — in-stack PortAllocator punch (scaffold).
+//
+// Until Aorus / rebuild host drops a punch-capable libwebrtc.dll that exports
+// a narrow SymmetricPunchToRemotes (or equivalent) C++ API, MethodChannel
+// handlers live in flutter_nat_punch.{h,cc} and return rebuild_pending.
+// Do NOT #include cricket headers or call missing DLL symbols from this tree.
+//
+// Future flip (after binary drop + wrapper C API):
+//   1. Set CPPS_IN_STACK_LIBWEBRTC_READY to 1 in flutter_nat_punch.cc
+//   2. Call libwebrtc wrapper from InStackSymmetric
+//   3. Keep out-of-stack natPunchSymmetric as fallback when available=false
+//
+// Reserved MethodChannel names (registered, stubbed):
+//   natPunchInStackStatus
+//   natPunchInStackSymmetric
+
+#ifndef CPPS_IN_STACK_LIBWEBRTC_READY
+#define CPPS_IN_STACK_LIBWEBRTC_READY 0
+#endif
+
+#endif  // FLUTTER_WEBRTC_NAT_PUNCH_IN_STACK_HXX

 }
 
+void FlutterNatPunch::InStackStatus(
+    const EncodableMap& /*params*/,
+    std::unique_ptr<MethodResultProxy> result) {
+  // Stock third_party libwebrtc has no SymmetricPunchToRemotes export yet.
+  // Flip when Aorus / rebuild host drops a punch-capable DLL + C API.
+  EncodableMap out;
+#if CPPS_IN_STACK_LIBWEBRTC_READY
+  out[EncodableValue("available")] = EncodableValue(true);
+  out[EncodableValue("reason")] = EncodableValue("ready");
+#else
+  out[EncodableValue("available")] = EncodableValue(false);
+  out[EncodableValue("reason")] = EncodableValue("rebuild_pending");
+#endif
+  out[EncodableValue("pin")] = EncodableValue("m125");
+  result->Success(EncodableValue(out));
+}
+
+void FlutterNatPunch::InStackSymmetric(
+    const EncodableMap& /*params*/,
+    std::unique_ptr<MethodResultProxy> result) {
+  EncodableMap out;
+#if CPPS_IN_STACK_LIBWEBRTC_READY
+  // Real path: resolve PeerConnection → PortAllocatorSession →
+  // SymmetricPunchToRemotes (see patches/in-stack-punch/external/).
+  out[EncodableValue("available")] = EncodableValue(false);
+  out[EncodableValue("reason")] = EncodableValue("not_wired");
+  out[EncodableValue("attempts")] = EncodableValue(0);
+#else
+  out[EncodableValue("available")] = EncodableValue(false);
+  out[EncodableValue("reason")] = EncodableValue("rebuild_pending");
+  out[EncodableValue("attempts")] = EncodableValue(0);
+#endif
+  result->Success(EncodableValue(out));
+}
+
 }  // namespace flutter_webrtc_plugin

new file mode 100644
index 0000000..211ed75
--- /dev/null
+++ b/test/privacy_session_modes_test.dart
@@ -0,0 +1,37 @@
+import 'package:cloudplayplus/services/privacy_session_modes.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:privacy_blank_display/privacy_blank_display.dart';
+
+void main() {
+  test('effectiveMode picks strongest among sessions', () {
+    final modes = PrivacySessionModes();
+    modes.setSessionMode('a', PrivacyBlankMode.off);
+    modes.setSessionMode('b', PrivacyBlankMode.blankDisplay);
+    expect(modes.effectiveMode(), PrivacyBlankMode.blankDisplay);
+
+    modes.setSessionMode('c', PrivacyBlankMode.privacyScreen);
+    expect(modes.effectiveMode(), PrivacyBlankMode.privacyScreen);
+
+    modes.removeSession('c');
+    expect(modes.effectiveMode(), PrivacyBlankMode.blankDisplay);
+
+    modes.removeSession('b');
+    expect(modes.effectiveMode(), PrivacyBlankMode.off);
+  });
+
+  test('one session force-off does not clear another session blank', () {
+    final modes = PrivacySessionModes();
+    modes.setSessionMode('ctrl-1', PrivacyBlankMode.blankDisplay);
+    modes.setSessionMode('ctrl-2', PrivacyBlankMode.off);
+    expect(modes.effectiveMode(), PrivacyBlankMode.blankDisplay);
+    expect(modes.hasBlankDisplay, isTrue);
+  });
+
+  test('clear empties aggregator', () {
+    final modes = PrivacySessionModes();
+    modes.setSessionMode('x', PrivacyBlankMode.privacyScreen);
+    modes.clear();
+    expect(modes.sessionCount, 0);
+    expect(modes.effectiveMode(), PrivacyBlankMode.off);
+  });
+}
diff --git a/test/reliable_channel_gate_test.dart b/test/reliable_channel_gate_test.dart
new file mode 100644
index 0000000..b2d473f
--- /dev/null
+++ b/test/reliable_channel_gate_test.dart
@@ -0,0 +1,78 @@
+import 'dart:typed_data';
+
+import 'package:cloudplayplus/services/reliable_channel_gate.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  test('control send is not blocked by high bufferedAmount', () async {
+    var buffered = 512 * 1024;
+    final sent = <String>[];
+    final gate = ReliableChannelGate(
+      isOpen: () => true,
+      bufferedAmount: () => buffered,
+      sendTextImpl: (t) async => sent.add(t),
+      sendBinaryImpl: (_) async {},
+      bulkHighWaterBytes: 256 * 1024,
+      bulkLowWaterBytes: 64 * 1024,
+      pollInterval: const Duration(milliseconds: 1),
+    );
+
+    await gate.sendText('privacy', priority: ReliableSendPriority.control);
+    expect(sent, ['privacy']);
+  });
+
+  test('bulk send waits until bufferedAmount drops', () async {
+    var buffered = 400 * 1024;
+    final sent = <int>[];
+    final gate = ReliableChannelGate(
+      isOpen: () => true,
+      bufferedAmount: () => buffered,
+      sendTextImpl: (_) async {},
+      sendBinaryImpl: (b) async => sent.add(b.length),
+      bulkHighWaterBytes: 256 * 1024,
+      bulkLowWaterBytes: 64 * 1024,
+      pollInterval: const Duration(milliseconds: 5),
+    );
+
+    final pending = gate.sendBinary(
+      Uint8List(8),
+      priority: ReliableSendPriority.bulk,
+    );
+    await Future<void>.delayed(const Duration(milliseconds: 20));
+    expect(sent, isEmpty);
+    expect(gate.isBulkBackpressured, isTrue);
+
+    buffered = 32 * 1024;
+    await pending;
+    expect(sent, [8]);
+    expect(gate.isBulkBackpressured, isFalse);
+  });
+
+  test('control completes while bulk is waiting on backpressure', () async {
+    var buffered = 400 * 1024;
+    final order = <String>[];
+    final gate = ReliableChannelGate(
+      isOpen: () => true,
+      bufferedAmount: () => buffered,
+      sendTextImpl: (t) async => order.add(t),
+      sendBinaryImpl: (_) async => order.add('bulk'),
+      bulkHighWaterBytes: 256 * 1024,
+      bulkLowWaterBytes: 64 * 1024,
+      pollInterval: const Duration(milliseconds: 5),
+    );
+
+    final bulk = gate.sendBinary(
+      Uint8List(1),
+      priority: ReliableSendPriority.bulk,
+    );
+    await Future<void>.delayed(const Duration(milliseconds: 10));
+    expect(gate.isBulkBackpressured, isTrue);
+
+    await gate.sendText('ctrl', priority: ReliableSendPriority.control);
+    expect(order, ['ctrl']);
+
+    buffered = 0;
+    await bulk;
+    expect(order, ['ctrl', 'bulk']);
+  });
+}

diff --git a/lib/services/privacy_session_modes.dart b/lib/services/privacy_session_modes.dart
new file mode 100644
index 0000000..6260d11
--- /dev/null
+++ b/lib/services/privacy_session_modes.dart
@@ -0,0 +1,40 @@
+import 'package:privacy_blank_display/privacy_blank_display.dart';
+
+/// Pure multi-session privacy aggregator (testable without native plugins).
+///
+/// Host privacy still applies through one process-level native surface, but
+/// each streaming session records its own desired mode. The effective mode is
+/// the strongest among active sessions (`privacyScreen` > `blankDisplay` >
+/// `off`) so one controller cannot silently clear another session's privacy.
+class PrivacySessionModes {
+  final Map<String, PrivacyBlankMode> _modes = {};
+
+  Map<String, PrivacyBlankMode> get snapshot =>
+      Map<String, PrivacyBlankMode>.unmodifiable(_modes);
+
+  int get sessionCount => _modes.length;
+
+  bool get hasBlankDisplay =>
+      _modes.values.any((m) => m == PrivacyBlankMode.blankDisplay);
+
+  void setSessionMode(String sessionId, PrivacyBlankMode mode) {
+    _modes[sessionId] = mode;
+  }
+
+  void removeSession(String sessionId) {
+    _modes.remove(sessionId);
+  }
+
+  void clear() => _modes.clear();
+
+  /// Strongest mode among tracked sessions, or [PrivacyBlankMode.off] if none.
+  PrivacyBlankMode effectiveMode() {
+    var best = PrivacyBlankMode.off;
+    for (final mode in _modes.values) {
+      if (mode.index > best.index) {
+        best = mode;
+      }
+    }
+    return best;
+  }
+}
diff --git a/lib/services/reliable_channel_gate.dart b/lib/services/reliable_channel_gate.dart
new file mode 100644
index 0000000..99c92e1
--- /dev/null
+++ b/lib/services/reliable_channel_gate.dart
@@ -0,0 +1,133 @@
+import 'dart:async';
+import 'dart:typed_data';
+
+/// Send priority on the shared reliable `userInput` data channel.
+///
+/// **Design choice (post-merge Medium #1):** keep one ordered reliable channel
+/// (no second SCTP stream) and apply priority + `bufferedAmount` backpressure
+/// so file/terminal bulk traffic cannot starve privacy/control messages.
+enum ReliableSendPriority {
+  /// Privacy opcodes, file/term control JSON, pings — never blocked by bulk.
+  control,
+
+  /// File / terminal binary chunks — wait when the SCTP send buffer is high.
+  bulk,
+}
+
+/// Priority send gate wrapping one [RTCDataChannel]-like reliable channel.
+///
+/// Control messages call `send` immediately (serialized only with other
+/// in-flight sends) and do **not** wait on the bulk backpressure loop, so a
+/// file/terminal flood cannot delay privacy flips. Bulk senders pause when
+/// `bufferedAmount` is high; optional [onBulkBackpressure] tips the UI.
+class ReliableChannelGate {
+  ReliableChannelGate({
+    required this.isOpen,
+    required this.bufferedAmount,
+    required this.sendTextImpl,
+    required this.sendBinaryImpl,
+    this.bulkHighWaterBytes = 256 * 1024,
+    this.bulkLowWaterBytes = 64 * 1024,
+    this.pollInterval = const Duration(milliseconds: 16),
+    this.onBulkBackpressure,
+  }) : assert(bulkLowWaterBytes <= bulkHighWaterBytes);
+
+  final bool Function() isOpen;
+  final int Function() bufferedAmount;
+  final Future<void> Function(String text) sendTextImpl;
+  final Future<void> Function(Uint8List bytes) sendBinaryImpl;
+
+  /// Pause new bulk sends when buffered amount is at or above this.
+  final int bulkHighWaterBytes;
+
+  /// Resume bulk sends after waiting once buffered amount drops to this.
+  final int bulkLowWaterBytes;
+
+  final Duration pollInterval;
+
+  /// Fired when bulk backpressure starts (`true`) or clears (`false`).
+  final void Function(bool active)? onBulkBackpressure;
+
+  Future<void> _sendChain = Future<void>.value();
+  bool _bulkWaiting = false;
+  bool _disposed = false;
+
+  bool get isBulkBackpressured => _bulkWaiting;
+
+  /// Enqueue a text send. Control bypasses bulk buffer wait.
+  Future<void> sendText(
+    String text, {
+    ReliableSendPriority priority = ReliableSendPriority.control,
+  }) {
+    return _send(priority, () => sendTextImpl(text));
+  }
+
+  /// Enqueue a binary send. Control bypasses bulk buffer wait.
+  Future<void> sendBinary(
+    Uint8List bytes, {
+    ReliableSendPriority priority = ReliableSendPriority.control,
+  }) {
+    return _send(priority, () => sendBinaryImpl(bytes));
+  }
+
+  Future<void> _send(
+    ReliableSendPriority priority,
+    Future<void> Function() doSend,
+  ) async {
+    if (_disposed) {
+      throw StateError('ReliableChannelGate disposed');
+    }
+    if (priority == ReliableSendPriority.bulk) {
+      await _waitForBulkBudget();
+    }
+    return _withSendLock(doSend);
+  }
+
+  /// Serialize actual channel.send calls (control may cut ahead of bulk wait).
+  Future<void> _withSendLock(Future<void> Function() job) {
+    if (_disposed) {
+      return Future.error(StateError('ReliableChannelGate disposed'));
+    }
+    final done = Completer<void>();
+    _sendChain = _sendChain.then((_) async {
+      try {
+        _ensureOpen();
+        await job();
+        if (!done.isCompleted) done.complete();
+      } catch (e, st) {
+        if (!done.isCompleted) done.completeError(e, st);
+      }
+    });
+    _sendChain = _sendChain.catchError((_) {});
+    return done.future;
+  }
+
+  Future<void> _waitForBulkBudget() async {
+    if (bufferedAmount() < bulkHighWaterBytes) {
+      _setBulkWaiting(false);
+      return;
+    }
+    _setBulkWaiting(true);
+    while (!_disposed && isOpen() && bufferedAmount() > bulkLowWaterBytes) {
+      await Future<void>.delayed(pollInterval);
+    }
+    _setBulkWaiting(false);
+  }
+
+  void _setBulkWaiting(bool active) {
+    if (_bulkWaiting == active) return;
+    _bulkWaiting = active;
+    onBulkBackpressure?.call(active);
+  }
+
+  void _ensureOpen() {
+    if (_disposed || !isOpen()) {
+      throw StateError('Reliable data channel is not open');
+    }
+  }
+
+  void dispose() {
+    _disposed = true;
+    _setBulkWaiting(false);
+  }
+}

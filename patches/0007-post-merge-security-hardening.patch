diff --git a/lib/utils/widgets/streaming_floating_menu.dart b/lib/utils/widgets/streaming_floating_menu.dart
new file mode 100644
index 0000000..5c5c798
--- /dev/null
+++ b/lib/utils/widgets/streaming_floating_menu.dart
@@ -0,0 +1,41 @@
+import 'package:flutter/material.dart';
+
+/// In-session floating menu actions.
+///
+/// Index order **must** match [StreamingFloatingMenu.icons]. Named values
+/// replace bare `index == 5..8` so later icon inserts do not silently shift
+/// privacy / file / terminal / close (post-merge Low #5).
+enum StreamingFloatingMenuAction {
+  fullscreen,
+  onlyRemote,
+  keyboard,
+  mouse,
+  gamepad,
+  privacy,
+  fileTransfer,
+  terminal,
+  close,
+}
+
+/// Icon list for [FloatingMenuPanel.buttons], aligned with
+/// [StreamingFloatingMenuAction] declaration order.
+abstract final class StreamingFloatingMenu {
+  static const List<IconData> icons = [
+    Icons.crop_free,
+    Icons.open_in_full,
+    Icons.keyboard,
+    Icons.mouse,
+    Icons.gamepad,
+    Icons.visibility_off,
+    Icons.folder_open,
+    Icons.terminal,
+    Icons.close,
+  ];
+
+  static void assertAligned() {
+    assert(
+      icons.length == StreamingFloatingMenuAction.values.length,
+      'StreamingFloatingMenu.icons must match StreamingFloatingMenuAction',
+    );
+  }
+}

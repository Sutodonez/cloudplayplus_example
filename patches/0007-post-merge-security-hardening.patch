+import 'package:cloudplayplus/utils/widgets/streaming_floating_menu.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  test('floating menu icons align with named actions', () {
+    StreamingFloatingMenu.assertAligned();
+    expect(
+      StreamingFloatingMenu.icons.length,
+      StreamingFloatingMenuAction.values.length,
+    );
+    expect(
+      StreamingFloatingMenu.icons[StreamingFloatingMenuAction.privacy.index],
+      Icons.visibility_off,
+    );
+    expect(
+      StreamingFloatingMenu
+          .icons[StreamingFloatingMenuAction.fileTransfer.index],
+      Icons.folder_open,
+    );
+    expect(
+      StreamingFloatingMenu.icons[StreamingFloatingMenuAction.terminal.index],
+      Icons.terminal,
+    );
+    expect(
+      StreamingFloatingMenu.icons[StreamingFloatingMenuAction.close.index],
+      Icons.close,
+    );
+  });
+}

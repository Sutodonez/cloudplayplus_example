diff --git a/lib/services/ice/ice_candidate_endpoint.dart b/lib/services/ice/ice_candidate_endpoint.dart
new file mode 100644
index 0000000..5e3b93a
--- /dev/null
+++ b/lib/services/ice/ice_candidate_endpoint.dart
@@ -0,0 +1,44 @@
+/// Parsed `a=candidate:` / `candidate:` endpoint for punch targeting.
+class IceCandidateEndpoint {
+  IceCandidateEndpoint({
+    required this.ip,
+    required this.port,
+    required this.protocol,
+    required this.type,
+  });
+
+  final String ip;
+  final int port;
+  final String protocol;
+  final String type;
+
+  bool get isPunchable =>
+      protocol == 'udp' &&
+      (type == 'srflx' || type == 'host' || type == 'prflx') &&
+      ip.isNotEmpty &&
+      port > 0 &&
+      port <= 65535 &&
+      type != 'relay';
+
+  /// Example: `candidate:1 1 UDP 2122260223 203.0.113.1 54321 typ srflx ...`
+  static IceCandidateEndpoint? parse(String raw) {
+    var line = raw.trim();
+    if (line.startsWith('a=')) line = line.substring(2);
+    if (!line.startsWith('candidate:')) return null;
+    final parts = line.split(RegExp(r'\s+'));
+    if (parts.length < 8) return null;
+    // candidate:<foundation> <component> <protocol> <priority> <ip> <port> typ <type>
+    final protocol = parts[2].toLowerCase();
+    final ip = parts[4];
+    final port = int.tryParse(parts[5]) ?? 0;
+    final typIdx = parts.indexOf('typ');
+    if (typIdx < 0 || typIdx + 1 >= parts.length) return null;
+    final type = parts[typIdx + 1].toLowerCase();
+    return IceCandidateEndpoint(
+      ip: ip,
+      port: port,
+      protocol: protocol,
+      type: type,
+    );
+  }
+}
diff --git a/lib/services/ice/ice_policy.dart b/lib/services/ice/ice_policy.dart
new file mode 100644
index 0000000..a6317b3
--- /dev/null
+++ b/lib/services/ice/ice_policy.dart
@@ -0,0 +1,114 @@
+import 'package:cloudplayplus/global_settings/streaming_settings.dart';
+import 'package:cloudplayplus/services/ice/ice_punch_options.dart';
+
+/// Builds RTCPeerConnection configuration for the soft ICE / TURN ladder
+/// that complements enhanced hole punch (does not replace punch).
+///
+/// Ladder (ideas only — not a copy of third-party binaries):
+/// 1. Prefer P2P: STUN (+ optional concurrent TURN) with `iceTransportPolicy: all`
+/// 2. Hard-NAT punch helper runs separately when [IcePunchOptions.enabled]
+/// 3. [IcePunchOptions.forceRelay] → TURN-only (`relay`)
+class IcePolicy {
+  IcePolicy._();
+
+  /// Returns the map passed to [createPeerConnection] (spread with sdpSemantics).
+  static Map<String, dynamic> buildPeerConnectionConfiguration({
+    required IcePunchOptions punch,
+    required bool useTurnServer,
+    String? turnUrl,
+    String? turnUsername,
+    String? turnCredential,
+    Map<String, dynamic>? stunServer,
+    Map<String, dynamic>? extraStunServer,
+    Map<String, dynamic>? testIceServers,
+  }) {
+    if (testIceServers != null) {
+      return {
+        ...testIceServers,
+        'sdpSemantics': 'unified-plan',
+        if (punch.forceRelay) 'iceTransportPolicy': 'relay',
+      };
+    }
+
+    final iceServers = <Map<String, dynamic>>[];
+    final stun = stunServer ?? cloudPlayPlusStun;
+    final extraStun = extraStunServer ?? officialStun1;
+    final turn = _turnServerMap(
+      turnUrl ?? StreamingSettings.customTurnServerAddress,
+      turnUsername ?? StreamingSettings.customTurnServerUsername,
+      turnCredential ?? StreamingSettings.customTurnServerPassword,
+    );
+
+    if (punch.forceRelay) {
+      // force_relay: TURN only.
+      if (turn != null) {
+        iceServers.add(turn);
+      } else {
+        iceServers.add(stun);
+      }
+    } else if (punch.enabled) {
+      // Soft ladder complement: concurrent STUN + TURN (when configured).
+      iceServers.add(stun);
+      if (extraStun != null &&
+          extraStun['urls'] != stun['urls']) {
+        iceServers.add(extraStun);
+      }
+      if (useTurnServer && turn != null) {
+        iceServers.add(turn);
+      }
+    } else if (useTurnServer) {
+      // Legacy: TURN-only when user toggles turn without punch.
+      if (turn != null) {
+        iceServers.add(turn);
+      } else {
+        iceServers.add(stun);
+      }
+    } else {
+      iceServers.add(stun);
+    }
+
+    final config = <String, dynamic>{
+      'iceServers': iceServers,
+      'sdpSemantics': 'unified-plan',
+    };
+
+    if (punch.forceRelay) {
+      config['iceTransportPolicy'] = 'relay';
+    } else {
+      config['iceTransportPolicy'] = 'all';
+    }
+
+    if (punch.enabled && !punch.forceRelay && punch.iceCandidatePoolSize > 0) {
+      config['iceCandidatePoolSize'] = punch.iceCandidatePoolSize;
+    }
+
+    return config;
+  }
+
+  static Map<String, dynamic>? _turnServerMap(
+    String? url,
+    String? username,
+    String? credential,
+  ) {
+    if (url == null || url.isEmpty) return null;
+    return {
+      'urls': url,
+      'username': username ?? '',
+      'credential': credential ?? '',
+    };
+  }
+
+  /// Whether a failed ICE attempt should be retried with forceRelay.
+  static bool shouldFallbackToRelay({
+    required IcePunchOptions punch,
+    required bool useTurnServer,
+    required bool alreadyTriedRelay,
+    String? turnUrl,
+  }) {
+    if (alreadyTriedRelay) return false;
+    if (punch.forceRelay) return false;
+    if (!punch.enabled && !useTurnServer) return false;
+    final url = turnUrl ?? StreamingSettings.customTurnServerAddress;
+    return url != null && url.isNotEmpty;
+  }
+}

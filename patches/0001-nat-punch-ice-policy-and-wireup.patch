new file mode 100644
index 0000000..c720329
--- /dev/null
+++ b/lib/services/ice/ice_punch_options.dart
@@ -0,0 +1,91 @@
+/// Stable Dart surface for enhanced / hard-NAT hole punch.
+///
+/// ABI freeze (see docs/cpp-punch-replay.md / patches/nat-punch):
+/// do not rename fields casually — native MethodChannel keys mirror these names.
+class IcePunchOptions {
+  /// Run firewall UDP probes + symmetric punch bursts toward remote candidates.
+  final bool enabled;
+
+  /// Prefer TURN-only ICE (`iceTransportPolicy: relay`).
+  final bool forceRelay;
+
+  /// Public hosts used for PunchCheckFireWall-style UDP probes (host only, port 53).
+  final List<String> probeHosts;
+
+  /// How many UDP sockets / source ports to open for symmetric punch bursts.
+  final int symmetricSocketCount;
+
+  /// Packets sent per remote candidate per local socket.
+  final int packetsPerSocket;
+
+  /// Delay between burst packets.
+  final Duration burstInterval;
+
+  /// Soft ladder: gather a small ICE candidate pool before offer when punch is on.
+  final int iceCandidatePoolSize;
+
+  static const List<String> defaultProbeHosts = [
+    '119.29.29.29',
+    '223.5.5.5',
+  ];
+
+  const IcePunchOptions({
+    this.enabled = true,
+    this.forceRelay = false,
+    this.probeHosts = defaultProbeHosts,
+    this.symmetricSocketCount = 8,
+    this.packetsPerSocket = 4,
+    this.burstInterval = const Duration(milliseconds: 20),
+    this.iceCandidatePoolSize = 4,
+  });
+
+  IcePunchOptions copyWith({
+    bool? enabled,
+    bool? forceRelay,
+    List<String>? probeHosts,
+    int? symmetricSocketCount,
+    int? packetsPerSocket,
+    Duration? burstInterval,
+    int? iceCandidatePoolSize,
+  }) {
+    return IcePunchOptions(
+      enabled: enabled ?? this.enabled,
+      forceRelay: forceRelay ?? this.forceRelay,
+      probeHosts: probeHosts ?? this.probeHosts,
+      symmetricSocketCount:
+          symmetricSocketCount ?? this.symmetricSocketCount,
+      packetsPerSocket: packetsPerSocket ?? this.packetsPerSocket,
+      burstInterval: burstInterval ?? this.burstInterval,
+      iceCandidatePoolSize:
+          iceCandidatePoolSize ?? this.iceCandidatePoolSize,
+    );
+  }
+
+  Map<String, dynamic> toJson() => {
+        'enabled': enabled,
+        'forceRelay': forceRelay,
+        'probeHosts': probeHosts,
+        'symmetricSocketCount': symmetricSocketCount,
+        'packetsPerSocket': packetsPerSocket,
+        'burstIntervalMs': burstInterval.inMilliseconds,
+        'iceCandidatePoolSize': iceCandidatePoolSize,
+      };
+
+  static IcePunchOptions fromJson(Map<String, dynamic>? json) {
+    if (json == null) return const IcePunchOptions();
+    final hosts = json['probeHosts'];
+    return IcePunchOptions(
+      enabled: json['enabled'] as bool? ?? true,
+      forceRelay: json['forceRelay'] as bool? ?? false,
+      probeHosts: hosts is List
+          ? hosts.map((e) => e.toString()).toList()
+          : defaultProbeHosts,
+      symmetricSocketCount: json['symmetricSocketCount'] as int? ?? 8,
+      packetsPerSocket: json['packetsPerSocket'] as int? ?? 4,
+      burstInterval: Duration(
+        milliseconds: json['burstIntervalMs'] as int? ?? 20,
+      ),
+      iceCandidatePoolSize: json['iceCandidatePoolSize'] as int? ?? 4,
+    );
+  }
+}

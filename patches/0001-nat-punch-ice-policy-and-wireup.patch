diff --git a/lib/services/ice/nat_punch_helper_io.dart b/lib/services/ice/nat_punch_helper_io.dart
new file mode 100644
index 0000000..9980ca8
--- /dev/null
+++ b/lib/services/ice/nat_punch_helper_io.dart
@@ -0,0 +1,217 @@
+import 'dart:io';
+import 'dart:math';
+import 'dart:typed_data';
+
+import 'package:cloudplayplus/base/logging.dart';
+import 'package:cloudplayplus/services/ice/ice_candidate_endpoint.dart';
+import 'package:cloudplayplus/services/ice/ice_punch_options.dart';
+import 'package:flutter_webrtc/flutter_webrtc.dart' as webrtc;
+
+/// Enhanced hole-punch helper (ladder design from GV notes — original code).
+///
+/// 1. [checkFirewall] — UDP probes to public DNS IPs (PunchCheckFireWall idea)
+/// 2. [symmetricPunchToRemoteCandidates] — multi-socket UDP bursts toward
+///    remote srflx/host candidates (RandomSymmetricPunchToCone idea)
+///
+/// Prefers the flutter-webrtc MethodChannel when available; falls back to
+/// [RawDatagramSocket] so the feature still works without a rebuilt plugin.
+class NatPunchHelper {
+  NatPunchHelper(this.options);
+
+  final IcePunchOptions options;
+  final Random _rng = Random();
+  bool _disposed = false;
+  final Set<String> _punchedTargets = {};
+
+  bool get isSupported => true;
+
+  Future<FirewallProbeResult> checkFirewall() async {
+    if (_disposed || !options.enabled) {
+      return const FirewallProbeResult(supported: true, reachableHosts: []);
+    }
+
+    try {
+      final native = await webrtc.NatPunch.probeFirewall(
+        hosts: options.probeHosts,
+        port: 53,
+        timeoutMs: 800,
+      );
+      if (native != null) {
+        final hosts = (native['reachableHosts'] as List?)
+                ?.map((e) => e.toString())
+                .toList() ??
+            [];
+        VLOG0('NatPunch native firewall probe: $hosts');
+        return FirewallProbeResult(supported: true, reachableHosts: hosts);
+      }
+    } catch (e) {
+      VLOG0('NatPunch native firewall probe unavailable: $e');
+    }
+
+    return _checkFirewallDart();
+  }
+
+  Future<FirewallProbeResult> _checkFirewallDart() async {
+    final reachable = <String>[];
+    for (final host in options.probeHosts) {
+      if (_disposed) break;
+      try {
+        InternetAddress address;
+        try {
+          address = InternetAddress(host);
+        } catch (_) {
+          final looked = await InternetAddress.lookup(host);
+          if (looked.isEmpty) continue;
+          address = looked.first;
+        }
+        final socket = await RawDatagramSocket.bind(InternetAddress.anyIPv4, 0);
+        try {
+          socket.send(Uint8List.fromList([0x00]), address, 53);
+          reachable.add(host);
+        } finally {
+          socket.close();
+        }
+      } catch (e) {
+        VLOG0('NatPunch firewall probe failed for $host: $e');
+      }
+    }
+    VLOG0('NatPunch dart firewall probe: $reachable');
+    return FirewallProbeResult(supported: true, reachableHosts: reachable);
+  }
+
+  /// Parse and punch when a remote ICE candidate arrives (srflx / host UDP).
+  Future<void> onRemoteIceCandidate(String? candidateLine) async {
+    if (_disposed || !options.enabled || options.forceRelay) return;
+    if (candidateLine == null || candidateLine.isEmpty) return;
+    final parsed = IceCandidateEndpoint.parse(candidateLine);
+    if (parsed == null || !parsed.isPunchable) return;
+    final key = '${parsed.ip}:${parsed.port}';
+    if (_punchedTargets.contains(key)) return;
+    _punchedTargets.add(key);
+    await symmetricPunchToRemoteCandidates([candidateLine]);
+  }
+
+  Future<SymmetricPunchResult> symmetricPunchToRemoteCandidates(
+    Iterable<String> candidateLines,
+  ) async {
+    if (_disposed || !options.enabled || options.forceRelay) {
+      return const SymmetricPunchResult(
+        supported: true,
+        targetsAttempted: 0,
+        packetsSent: 0,
+      );
+    }
+
+    final endpoints = <IceCandidateEndpoint>[];
+    for (final line in candidateLines) {
+      final e = IceCandidateEndpoint.parse(line);
+      if (e != null && e.isPunchable) {
+        endpoints.add(e);
+      }
+    }
+    if (endpoints.isEmpty) {
+      return const SymmetricPunchResult(
+        supported: true,
+        targetsAttempted: 0,
+        packetsSent: 0,
+      );
+    }
+
+    try {
+      final native = await webrtc.NatPunch.symmetricPunch(
+        targets: endpoints
+            .map((e) => {'ip': e.ip, 'port': e.port})
+            .toList(),
+        socketCount: options.symmetricSocketCount,
+        packetsPerSocket: options.packetsPerSocket,
+        intervalMs: options.burstInterval.inMilliseconds,
+      );
+      if (native != null) {
+        final sent = native['packetsSent'] as int? ?? 0;
+        VLOG0(
+            'NatPunch native symmetric punch: ${endpoints.length} targets, $sent packets');
+        return SymmetricPunchResult(
+          supported: true,
+          targetsAttempted: endpoints.length,
+          packetsSent: sent,
+        );
+      }
+    } catch (e) {
+      VLOG0('NatPunch native symmetric punch unavailable: $e');
+    }
+
+    return _symmetricPunchDart(endpoints);
+  }
+
+  Future<SymmetricPunchResult> _symmetricPunchDart(
+    List<IceCandidateEndpoint> endpoints,
+  ) async {
+    var packetsSent = 0;
+    final sockets = <RawDatagramSocket>[];
+    try {
+      for (var i = 0; i < options.symmetricSocketCount; i++) {
+        sockets.add(await RawDatagramSocket.bind(InternetAddress.anyIPv4, 0));
+      }
+      final payload = Uint8List(20);
+      // Minimal STUN-looking header (binding request type) — not a full STUN client.
+      payload[0] = 0x00;
+      payload[1] = 0x01;
+      for (var p = 0; p < options.packetsPerSocket; p++) {
+        if (_disposed) break;
+        for (final socket in sockets) {
+          for (final ep in endpoints) {
+            try {
+              final addr = InternetAddress(ep.ip);
+              // Slight port jitter for symmetric NAT port prediction experiments.
+              final portJitter = (p == 0)
+                  ? ep.port
+                  : (ep.port + _rng.nextInt(5) - 2).clamp(1, 65535);
+              packetsSent += socket.send(payload, addr, portJitter);
+            } catch (_) {}
+          }
+        }
+        if (p + 1 < options.packetsPerSocket) {
+          await Future<void>.delayed(options.burstInterval);
+        }
+      }
+    } finally {
+      for (final s in sockets) {
+        s.close();
+      }
+    }
+    VLOG0(
+        'NatPunch dart symmetric punch: ${endpoints.length} targets, $packetsSent packets');
+    return SymmetricPunchResult(
+      supported: true,
+      targetsAttempted: endpoints.length,
+      packetsSent: packetsSent,
+    );
+  }
+
+  void dispose() {
+    _disposed = true;
+    _punchedTargets.clear();
+  }
+}
+
+class FirewallProbeResult {
+  const FirewallProbeResult({
+    required this.supported,
+    required this.reachableHosts,
+  });
+
+  final bool supported;
+  final List<String> reachableHosts;
+}
+
+class SymmetricPunchResult {
+  const SymmetricPunchResult({
+    required this.supported,
+    required this.targetsAttempted,
+    required this.packetsSent,
+  });
+
+  final bool supported;
+  final int targetsAttempted;
+  final int packetsSent;
+}

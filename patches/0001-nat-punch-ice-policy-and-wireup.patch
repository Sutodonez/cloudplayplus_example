diff --git a/test/ice_policy_test.dart b/test/ice_policy_test.dart
new file mode 100644
index 0000000..db65fae
--- /dev/null
+++ b/test/ice_policy_test.dart
@@ -0,0 +1,142 @@
+import 'package:cloudplayplus/services/ice/ice_candidate_endpoint.dart';
+import 'package:cloudplayplus/services/ice/ice_policy.dart';
+import 'package:cloudplayplus/services/ice/ice_punch_options.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  group('IceCandidateEndpoint.parse', () {
+    test('parses srflx UDP candidate', () {
+      const line =
+          'candidate:1 1 UDP 2122260223 203.0.113.1 54321 typ srflx raddr 10.0.0.1 rport 54321';
+      final ep = IceCandidateEndpoint.parse(line);
+      expect(ep, isNotNull);
+      expect(ep!.ip, '203.0.113.1');
+      expect(ep.port, 54321);
+      expect(ep.protocol, 'udp');
+      expect(ep.type, 'srflx');
+      expect(ep.isPunchable, isTrue);
+    });
+
+    test('rejects relay candidates', () {
+      const line =
+          'candidate:2 1 udp 16777215 198.51.100.2 3478 typ relay raddr 10.0.0.2 rport 9';
+      final ep = IceCandidateEndpoint.parse(line);
+      expect(ep, isNotNull);
+      expect(ep!.isPunchable, isFalse);
+    });
+
+    test('parses a= prefix', () {
+      const line =
+          'a=candidate:1 1 udp 2122260223 192.0.2.1 10000 typ host';
+      final ep = IceCandidateEndpoint.parse(line);
+      expect(ep, isNotNull);
+      expect(ep!.type, 'host');
+      expect(ep.isPunchable, isTrue);
+    });
+  });
+
+  group('IcePolicy.buildPeerConnectionConfiguration', () {
+    final turn = {
+      'urls': 'turn:example.com:3478',
+      'username': 'u',
+      'credential': 'p',
+    };
+    final stun = {'urls': 'stun:stun.example:3478'};
+
+    test('punch enabled + turn → concurrent STUN+TURN, policy all', () {
+      final cfg = IcePolicy.buildPeerConnectionConfiguration(
+        punch: const IcePunchOptions(enabled: true, forceRelay: false),
+        useTurnServer: true,
+        turnUrl: turn['urls'],
+        turnUsername: turn['username'],
+        turnCredential: turn['credential'],
+        stunServer: stun,
+        extraStunServer: null,
+      );
+      expect(cfg['iceTransportPolicy'], 'all');
+      final servers = cfg['iceServers'] as List;
+      expect(servers.length, greaterThanOrEqualTo(2));
+      expect(cfg['iceCandidatePoolSize'], 4);
+    });
+
+    test('forceRelay → relay policy and TURN', () {
+      final cfg = IcePolicy.buildPeerConnectionConfiguration(
+        punch: const IcePunchOptions(enabled: true, forceRelay: true),
+        useTurnServer: false,
+        turnUrl: turn['urls'],
+        turnUsername: turn['username'],
+        turnCredential: turn['credential'],
+        stunServer: stun,
+      );
+      expect(cfg['iceTransportPolicy'], 'relay');
+      final servers = cfg['iceServers'] as List;
+      expect(servers.length, 1);
+      expect((servers.first as Map)['urls'], turn['urls']);
+    });
+
+    test('legacy turn-only without punch', () {
+      final cfg = IcePolicy.buildPeerConnectionConfiguration(
+        punch: const IcePunchOptions(enabled: false, forceRelay: false),
+        useTurnServer: true,
+        turnUrl: turn['urls'],
+        turnUsername: turn['username'],
+        turnCredential: turn['credential'],
+        stunServer: stun,
+      );
+      final servers = cfg['iceServers'] as List;
+      expect(servers.length, 1);
+      expect((servers.first as Map)['urls'], turn['urls']);
+    });
+
+    test('legacy stun-only without punch', () {
+      final cfg = IcePolicy.buildPeerConnectionConfiguration(
+        punch: const IcePunchOptions(enabled: false, forceRelay: false),
+        useTurnServer: false,
+        stunServer: stun,
+      );
+      final servers = cfg['iceServers'] as List;
+      expect(servers.length, 1);
+      expect((servers.first as Map)['urls'], stun['urls']);
+    });
+  });
+
+  group('IcePolicy.shouldFallbackToRelay', () {
+    test('suggests relay when punch on and turn configured', () {
+      expect(
+        IcePolicy.shouldFallbackToRelay(
+          punch: const IcePunchOptions(enabled: true),
+          useTurnServer: true,
+          alreadyTriedRelay: false,
+          turnUrl: 'turn:example.com:3478',
+        ),
+        isTrue,
+      );
+    });
+
+    test('does not suggest when already forceRelay', () {
+      expect(
+        IcePolicy.shouldFallbackToRelay(
+          punch: const IcePunchOptions(enabled: true, forceRelay: true),
+          useTurnServer: true,
+          alreadyTriedRelay: false,
+          turnUrl: 'turn:example.com:3478',
+        ),
+        isFalse,
+      );
+    });
+  });
+
+  group('IcePunchOptions', () {
+    test('round-trips json', () {
+      const opts = IcePunchOptions(
+        enabled: false,
+        forceRelay: true,
+        probeHosts: ['1.1.1.1'],
+      );
+      final again = IcePunchOptions.fromJson(opts.toJson());
+      expect(again.enabled, isFalse);
+      expect(again.forceRelay, isTrue);
+      expect(again.probeHosts, ['1.1.1.1']);
+    });
+  });
+}
